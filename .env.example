# Local / production configuration for Bundle Audit.
# Copy to .env. Never commit real secrets.

# PostgreSQL connection string.
DATABASE_URL="postgresql://bundleaudit:bundleaudit@localhost:5432/bundleaudit"

# Signs the httpOnly app session cookie. At least 32 random characters.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# AES-256-GCM key for Fanvue tokens at rest. 32 bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Public origin used to build the OAuth redirect URI. No trailing slash.
# Production must be HTTPS. Example: https://audit.example.com
APP_ORIGIN="http://localhost:3000"

# Fanvue OAuth confidential client. The secret stays on the server.
# Leave blank in demo-only setups. Blank credentials never fall back to sample data.
FANVUE_CLIENT_ID=""
FANVUE_CLIENT_SECRET=""

# Optional exact redirect. Defaults to ${APP_ORIGIN}/api/oauth/callback
FANVUE_REDIRECT_URI=""

# App UUID from the Fanvue Developer Area. Required to read subscription/me
# and to build the documented App Store listing link.
FANVUE_APP_UUID=""

# Active pricing-plan UUID. When set with FANVUE_APP_UUID, unpaid creators are
# sent to the documented App Store deeplink. This app never starts an external checkout.
FANVUE_PLAN_UUID=""

# Per-app webhook signing secret from the Events tab (not the OAuth client secret).
FANVUE_WEBHOOK_SECRET=""

# Space-separated override. Defaults to the minimum read scopes this app uses.
# openid, offline_access and offline are always added for off-platform refresh tokens.
FANVUE_SCOPES=""

# Public contacts. Replace the examples before App Store submission.
SUPPORT_EMAIL="support@example.com"
SECURITY_EMAIL="security@example.com"
APP_OWNER_NAME="[App owner legal name]"
